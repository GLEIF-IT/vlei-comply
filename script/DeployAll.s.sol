pragma solidity ^0.8.24;

import "forge-std/Script.sol";
import "forge-std/console.sol";
import "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";

// Core infrastructure
import "../src/admin/AdminControls.sol";
import "../src/policy/PolicyManager.sol";
import "../src/policy/AllowAllPolicyEngine.sol";

// CHAINLINK_CCI Framework
import "../src/identity/TrustedIssuerRegistry.sol";
import "../src/identity/IdentityRegistry.sol";
import "../src/identity/CredentialRegistry.sol";
import "../src/identity/CredentialRegistryIdentityValidator.sol";
import "../src/identity/ChainlinkCCIDIdentityAdapter.sol";
import "../src/identity/interfaces/ICredentialRequirements.sol";

// Attestation Services
import "../src/attestation/VLEIOracleRegistry.sol";
import "../src/attestation/VLEILegalEntityVerifier.sol";

// Generated contracts
import "../src/assets/vLEI.sol";
import "../src/wrappers/wvLEI.sol";
import "../src/policies/VLEILegalEntityKYCPolicy.sol";

/**
 * @title DeployAll
 * @notice Local/CLI deployment script for the vLEI compliance prototype.
 * @dev Generated by GL1 Compliance Wizard and adapted for the first-pass vLEI oracle path.
 * The script deploys Chainlink-style registries behind ERC1967 proxies and initializes them
 * with a dev-only `AllowAllPolicyEngine` so Anvil/cast demos can register identities locally.
 * Do not treat this as a production deployment recipe without replacing the policy engine,
 * governance, oracle posting process, and key management.
 *
 * Deployment Order:
 * 1. AdminControls
 * 2. CHAINLINK_CCI Framework (TrustedIssuerRegistry, IdentityRegistry, CredentialRegistry, Validator)
 * 3. PolicyManager
 * 4. Attestation Service Verifiers
 * 5. Generated Policies
 * 6. Base Asset
 * 7. Policy Wrapper
 *
 * @custom:prototype This script optimizes for deterministic local demos and operator learning.
 */
contract DeployAll is Script {
    /// @notice Deploys the full local prototype stack and prints contract addresses.
    /// @dev Reads `PRIVATE_KEY` from the environment and broadcasts all deployments from that key.
    /// The printed addresses are intended for the CLI demo in `docs/cli-demo.md`.
    function run() external {
        uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
        address deployer = vm.addr(deployerPrivateKey);
        
        // Infrastructure
        AdminControls adminControls;
        AllowAllPolicyEngine devPolicyEngine;
        TrustedIssuerRegistry trustedIssuerRegistry;
        IdentityRegistry vendorIdentityRegistry;
        CredentialRegistry credentialRegistry;
        CredentialRegistryIdentityValidator credentialRegistryIdentityValidator;
        
        // Adapter & Manager
        IGL1IdentityRegistry identityRegistry;
        PolicyManager policyManager;

        
        console.log("Deploying vLEI Compliance Integration...");
        console.log("Deployer:", deployer);
        
        vm.startBroadcast(deployerPrivateKey);
        
        // ========================================
        // 1. Deploy AdminControls
        // ========================================
        adminControls = new AdminControls(deployer);
        console.log("AdminControls deployed to:", address(adminControls));

        
        // Initial Allowlist Seeding
        console.log("Seeding allowlist...");
        adminControls.setAllowed(deployer, true);
        console.log("Allowed deployer:", deployer);
        
        
        // ========================================
        // 2. Deploy CHAINLINK_CCI Framework (Proxy Deployment for Testing)
        // ========================================
        /**
         * @dev NOTE: This script is configured for TESTING AND DEVELOPMENT ONLY.
         *      - Chainlink-style registries are deployed behind ERC1967Proxy.
         *      - A dev-only allow-all policy engine enables local registry writes.
         *
         *      Production deployments should use a real policy engine and oracle pipeline.
         */

        devPolicyEngine = new AllowAllPolicyEngine();
        console.log("AllowAllPolicyEngine deployed to:", address(devPolicyEngine));
        
        // CredentialRegistryIdentityValidator
        CredentialRegistryIdentityValidator credentialValidatorImpl = new CredentialRegistryIdentityValidator();
        ICredentialRequirements.CredentialSourceInput[] memory sourceInputs =
            new ICredentialRequirements.CredentialSourceInput[](0);
        ICredentialRequirements.CredentialRequirementInput[] memory requirementInputs =
            new ICredentialRequirements.CredentialRequirementInput[](0);
        ERC1967Proxy credentialValidatorProxy = new ERC1967Proxy(
            address(credentialValidatorImpl),
            abi.encodeCall(CredentialRegistryIdentityValidator.initialize, (sourceInputs, requirementInputs))
        );
        credentialRegistryIdentityValidator = CredentialRegistryIdentityValidator(address(credentialValidatorProxy));
        console.log(
            "CredentialRegistryIdentityValidator deployed (proxy) to:",
            address(credentialRegistryIdentityValidator)
        );
        
        // IdentityRegistry
        IdentityRegistry identityRegistryImpl = new IdentityRegistry();
        ERC1967Proxy identityRegistryProxy = new ERC1967Proxy(
            address(identityRegistryImpl),
            abi.encodeCall(IdentityRegistry.initialize, (address(devPolicyEngine), deployer))
        );
        vendorIdentityRegistry = IdentityRegistry(address(identityRegistryProxy));
        console.log("Vendor IdentityRegistry deployed (proxy) to:", address(vendorIdentityRegistry));
        
        // CredentialRegistry
        CredentialRegistry credentialRegistryImpl = new CredentialRegistry();
        ERC1967Proxy credentialRegistryProxy = new ERC1967Proxy(
            address(credentialRegistryImpl),
            abi.encodeCall(CredentialRegistry.initialize, (address(devPolicyEngine), deployer))
        );
        credentialRegistry = CredentialRegistry(address(credentialRegistryProxy));
        console.log("CredentialRegistry deployed (proxy) to:", address(credentialRegistry));
        
        // TrustedIssuerRegistry
        TrustedIssuerRegistry trustedIssuerRegistryImpl = new TrustedIssuerRegistry();
        ERC1967Proxy trustedIssuerRegistryProxy = new ERC1967Proxy(
            address(trustedIssuerRegistryImpl),
            abi.encodeCall(TrustedIssuerRegistry.initialize, (address(devPolicyEngine), deployer))
        );
        trustedIssuerRegistry = TrustedIssuerRegistry(address(trustedIssuerRegistryProxy));
        console.log("TrustedIssuerRegistry deployed (proxy) to:", address(trustedIssuerRegistry));
        
        // Deploy Adapter that bridges Wizard interfaces to Vendor registries
        identityRegistry = IGL1IdentityRegistry(address(new ChainlinkCCIDIdentityAdapter(
            address(vendorIdentityRegistry),
            address(credentialRegistry)
        )));
        console.log("ChainlinkCCIDIdentityAdapter deployed to:", address(identityRegistry));
        
        // ========================================
        // 3. Policy Engine
        // ========================================
        
        // Deploy Policy Manager
        policyManager = new PolicyManager(
            address(adminControls),
            address(identityRegistry) // Note: Using the Adapter as the IGL1IdentityRegistry interface for rules!
        );
        console.log("PolicyManager deployed to:", address(policyManager));
        
        // ========================================
        // 4. Deploy Attestation Service Verifiers
        // ========================================




        VLEIOracleRegistry oracleRegistry = new VLEIOracleRegistry(address(adminControls));
        console.log("VLEIOracleRegistry deployed to:", address(oracleRegistry));

        VLEILegalEntityVerifier vleiVerifier = new VLEILegalEntityVerifier(address(oracleRegistry));
        console.log("VLEILegalEntityVerifier deployed to:", address(vleiVerifier));
        

        // ========================================
        // 5. Deploy Generated Policies
        // ========================================
        // Deploy VLEILegalEntityKYCPolicy
        VLEILegalEntityKYCPolicy vleiPolicy = new VLEILegalEntityKYCPolicy(
            1,
            address(identityRegistry),
            address(vleiVerifier),
            address(vleiVerifier)
        );
        console.log("VLEILegalEntityKYCPolicy deployed to:", address(vleiPolicy));
        
        // Register policies with PolicyManager
        policyManager.addPolicy(address(vleiPolicy));
        
        // ========================================
        // 6. Deploy Base Asset
        // ========================================
        vLEI asset = new vLEI(
            "vLEI",
            "VLEI",
            18,
            deployer,
            0, // No initial supply
            address(adminControls)
        );
        console.log("vLEI deployed to:", address(asset));
        
        // ========================================
        // 7. Deploy Policy Wrapper
        // ========================================
        wvLEI wrapper = new wvLEI(
            address(asset),
            address(policyManager),
            address(adminControls)
        );
        console.log("wvLEI deployed to:", address(wrapper));
        
        vm.stopBroadcast();
        
        // ========================================
        // Deployment Summary
        // ========================================
        console.log("");
        console.log("========================================");
        console.log("Deployment Complete!");
        console.log("========================================");
        console.log("AdminControls:", address(adminControls));
        console.log("AllowAllPolicyEngine:", address(devPolicyEngine));
        console.log("TrustedIssuerRegistry:", address(trustedIssuerRegistry));
        console.log("Vendor IdentityRegistry:", address(vendorIdentityRegistry));
        console.log("IdentityRegistry (Adapter):", address(identityRegistry));
        console.log("CredentialRegistry:", address(credentialRegistry));
        console.log("CredentialRegistryIdentityValidator:", address(credentialRegistryIdentityValidator));
        console.log("PolicyManager:", address(policyManager));

        console.log("VLEIOracleRegistry:", address(oracleRegistry));
        console.log("VLEILegalEntityVerifier:", address(vleiVerifier));
        console.log("Asset (vLEI):", address(asset));
        console.log("Wrapper (wvLEI):", address(wrapper));
        console.log("========================================");
    }
}
