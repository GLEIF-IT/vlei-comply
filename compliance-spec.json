{
  "version": "1.0",
  "compatibility": "EVM",
  "assetStandard": "ERC20",
  "assetDecimals": 6,
  "vaspMediation": "ENTITY_TO_ENTITY",
  "identityFramework": "ChainlinkCCI",
  "attestationServices": [
    {
      "name": "vLEI Oracle",
      "status": "ACTIVE"
    }
  ],
  "contracts": {
    "policyWrapper": "wUSDC.sol",
    "policyManager": "PolicyManager.sol",
    "identityManager": "IdentityRegistry.sol",
    "asset": "USDC.sol",
    "adminControls": "AdminControls.sol",
    "attestationVerifier": "VLEIEndorsementChecker.sol",
    "oracleRegistry": "VLEIOracleRegistry.sol"
  },
  "policies": [
    {
      "name": "VLEIWalletAssociationPolicy",
      "description": "Require current exact-wallet endorsements for originator and beneficiary customers",
      "contractName": "VLEIWalletAssociationPolicy",
      "constructorArgs": [
        1,
        "%%ATTESTATION_VERIFIER%%"
      ]
    }
  ],
  "adminRoles": {
    "owner": "constructor_param",
    "complianceAdmin": "constructor_param"
  },
  "adminCapabilities": {
    "globalPause": true,
    "wrapperPause": true,
    "policyFreeze": false
  },
  "identityFeatures": [
    {
      "key": "kycMode",
      "fieldName": "kycVerification",
      "label": "KYC Verification",
      "category": "CREDENTIAL",
      "mode": "PROOF"
    },
    {
      "key": "enableKycLevels",
      "fieldName": "kycLevel",
      "label": "KYC Level",
      "category": "NUMERICAL",
      "mode": "ENABLED"
    },
    {
      "key": "sanctionsMode",
      "fieldName": "sanctionsScreening",
      "label": "Sanctions Screening",
      "category": "CREDENTIAL",
      "mode": "PROOF"
    },
    {
      "key": "hasVASPLicense",
      "fieldName": "hasVASPLicense",
      "label": "VASP License",
      "category": "CREDENTIAL",
      "mode": "DISABLED"
    }
  ]
}
